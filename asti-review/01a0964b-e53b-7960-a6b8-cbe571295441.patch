+<script>
+const ids = ['a1','a2','a3','a4','a5','a6','b1','b2','b3','b4','b5','b6','c1','c2','c3','c4','c5','c6'];
+const labels = {
+  a1:'期刊/年份/卷期页', a2:'图', a3:'表', a4:'一级标题', a5:'参考文献条数', a6:'补充',
+  b1:'期刊/年份/卷期页', b2:'图', b3:'表', b4:'一级标题', b5:'参考文献条数', b6:'补充',
+  c1:'期刊/年份/卷期页', c2:'图', c3:'表', c4:'一级标题', c5:'参考文献条数', c6:'覆盖病种'
+};
+
+function build() {
+  const v = id => (document.getElementById(id).value || '').trim();
+  const fmt = (v, label) => v ? '  - ' + label + '：' + v.replace(/\n/g, ' / ') + '\n' : '';
+
+  let out = '【范文核对 · 回填】\n\n';
+
+  out += '范文① 脾不散精/糖酵解/急性肺损伤（徐倩）\n';
+  out += fmt(v('a1'), '期刊') + fmt(v('a2'), '图') + fmt(v('a3'), '表')
+       + fmt(v('a4'), '一级标题') + fmt(v('a5'), '参考文献') + fmt(v('a6'), '补充') + '\n';
+
+  out += '范文② 巨噬细胞自噬/糖尿病动脉粥样硬化（宁宇）\n';
+  out += fmt(v('b1'), '期刊') + fmt(v('b2'), '图') + fmt(v('b3'), '表')
+       + fmt(v('b4'), '一级标题') + fmt(v('b5'), '参考文献') + fmt(v('b6'), '补充') + '\n';
+
+  out += '范文③ 巨噬细胞极化/肺系疾病（朱虹宇）\n';
+  out += fmt(v('c1'), '期刊') + fmt(v('c2'), '图') + fmt(v('c3'), '表')
+       + fmt(v('c4'), '一级标题') + fmt(v('c5'), '参考文献') + fmt(v('c6'), '覆盖病种') + '\n';
+
+  return out;
+}
+
+document.getElementById('copyBtn').addEventListener('click', async function () {
+  const out = build();
+  const ta = document.getElementById('out');
+  ta.value = out;
+  ta.style.display = 'block';
+
+  try {
+    await navigator.clipboard.writeText(out);
+    this.textContent = '✓ 已复制，去对话里粘贴';
+    this.classList.add('done');
+    setTimeout(() => { this.textContent = '生成并复制'; this.classList.remove('done'); }, 3500);
+  } catch (e) {
+    ta.focus(); ta.select();
+    this.textContent = '请手动复制（已全选）';
+    try { document.execCommand('copy'); } catch (_) {}
+  }
+});
+
+document.getElementById('clearBtn').addEventListener('click', function () {
+  ids.forEach(id => { document.getElementById(id).value = ''; });
+  const ta = document.getElementById('out');
+  ta.value = ''; ta.style.display = 'none';
+});
+</script>
